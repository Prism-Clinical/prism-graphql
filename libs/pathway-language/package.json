{
  "name": "@prism/pathway-language",
  "version": "0.0.0-experimental",
  "private": true,
  "description": "EXPERIMENTAL, NONCLINICAL. Isolated Prism Pathway Language core experiments. Currently the S1 revision-history resolver and S2 candidate identification.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "test:s1": "jest src/__tests__/s1",
    "test:s2": "jest src/__tests__/s2"
  },
  "dependencies": {
    "canonicalize": "2.1.0"
  },
  "devDependencies": {
    "@types/jest": "^29.0.3",
    "@types/node": "^22.0.0",
    "jest": "^29.0.3",
    "ts-jest": "^29.0.2",
    "typescript": "^5.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": ["src"],
    "testRegex": "/__tests__/.*\\.test\\.ts$",
    "transform": {
      "^.+\\.ts$": ["ts-jest", { "tsconfig": "tsconfig.json" }]
    }
  }
}
