{
  "id": "PPL-08c",
  "title": "Multi-query preview: two incomplete queries with different hole kinds",
  "status": "Proposed, hand-derived acceptance expectation for a multi-query preview program. Not produced by any PPL compiler or evaluator. A bounded I6 slice (experimentalExecutePreviewFromRawRecords, multi-query preview) checks every expected output and trace source/result, each complete query's causeAttribution, and per query (queryPreview): authoring state, stages run, snapshot-statement handling and, for a criterion-holed query, the per-record establishes/refutes values its preview-query evaluation returns. A complete query's evidence trace holds S6 summaries only; no per-record S5 value is claimed for it. The program is IncompleteAuthoring with publication Blocked. No end-to-end PPL conformance, I6 completion or clinical approval is implied.",
  "program": {
    "file": "../schematic-demo-finding.ppl.json",
    "patch": [
      {
        "op": "replace",
        "path": "/nodes",
        "value": [
          {
            "id": "q.demo",
            "kind": "EvidenceQuery",
            "subject": "patient",
            "output": "Evidence<Boolean>",
            "contract": {
              "retrieve": {
                "type": "demo-model/DemoAssessment@0.1",
                "sources": [
                  "s1",
                  "s2"
                ],
                "valueSet": "demo-vs/item-x@1"
              },
              "corrections": {
                "authority": "demo-policy/same-source-amend@1"
              },
              "admissible": {
                "episode": {
                  "eq": [
                    {
                      "field": [
                        "c",
                        "episode"
                      ]
                    },
                    {
                      "ref": "ctx.episode"
                    }
                  ]
                },
                "encounter": {
                  "eq": [
                    {
                      "field": [
                        "c",
                        "encounter"
                      ]
                    },
                    {
                      "ref": "ctx.encounter"
                    }
                  ]
                },
                "assertionKind": {
                  "in": [
                    "ClinicianDocumented",
                    "PatientReport"
                  ]
                }
              },
              "policy": "explicit-assertion-v0",
              "establishes": {
                "eq": [
                  {
                    "field": [
                      "c",
                      "assertion"
                    ]
                  },
                  {
                    "enum": "AssertionValue.Affirmed"
                  }
                ]
              },
              "refutes": {
                "hole": {
                  "id": "H-DEMO-REF",
                  "type": "Decision",
                  "explains": "Schematic criterion hole: q.demo's refutes criterion is deliberately left undecided (nonclinical)."
                }
              },
              "obligations": [
                {
                  "disjoint": [
                    "establishes",
                    "refutes"
                  ]
                }
              ]
            },
            "rationale": "The q.demo contract with its refutes criterion replaced by an authoring hole (nonclinical); establishes stays complete."
          },
          {
            "id": "q.alt",
            "kind": "EvidenceQuery",
            "subject": "patient",
            "output": "Evidence<Boolean>",
            "contract": {
              "hole": {
                "id": "H-ALT",
                "type": "EvidenceSelectionContract<Boolean>",
                "explains": "Schematic whole-contract hole: q.alt's evidence contract is deliberately left undecided (nonclinical)."
              }
            },
            "rationale": "Schematic second query (nonclinical): a whole-contract authoring hole."
          },
          {
            "id": "p.demo",
            "kind": "Predicate",
            "expr": {
              "evidenceValue": {
                "ref": "q.demo"
              }
            }
          },
          {
            "id": "p.alt",
            "kind": "Predicate",
            "expr": {
              "evidenceValue": {
                "ref": "q.alt"
              }
            }
          },
          {
            "id": "f.demo",
            "kind": "Finding",
            "status": {
              "all": [
                {
                  "ref": "applicability"
                },
                {
                  "ref": "p.demo"
                }
              ]
            },
            "label": "Schematic finding: demonstration item affirmed (nonclinical)"
          },
          {
            "id": "f.both",
            "kind": "Finding",
            "status": {
              "all": [
                {
                  "ref": "applicability"
                },
                {
                  "ref": "p.demo"
                },
                {
                  "ref": "p.alt"
                }
              ]
            },
            "label": "Schematic finding: both demonstration queries (nonclinical)"
          }
        ]
      }
    ]
  },
  "entryPoints": [
    "compile",
    "compilePreview",
    "evaluatePreview"
  ],
  "basedOn": {
    "inputFixture": "EA-001",
    "queries": [],
    "claim": "No query is complete, so no evidence exists. q.demo is criterion-holed: S1–S5 run on EA-001's Affirmed record s1/r1, its complete establishes criterion is True and refutes is a Marker. q.alt is a whole-contract hole: no stage runs. Every output reading a query keeps that query's marker; f.both keeps both."
