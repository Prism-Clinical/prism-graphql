      ],
      "dependencyEdges": [
        [
          "f.both",
          "applicability"
        ],
        [
          "f.both",
          "p.alt"
        ],
        [
          "f.both",
          "p.demo"
        ],
        [
          "f.demo",
          "applicability"
        ],
        [
          "f.demo",
          "p.demo"
        ],
        [
          "p.alt",
          "q.alt"
        ],
        [
          "p.demo",
          "q.demo"
        ]
      ]
    },
    "preview": {
