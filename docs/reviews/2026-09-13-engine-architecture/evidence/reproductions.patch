+import { TraversalEngine } from '../services/resolution/traversal-engine';
+import { makeEvaluationTemporalContext } from '../services/resolution/temporal/evaluation-context';
+import { NodeStatus, GateType, DefaultBehavior, AnswerType, OverrideAction } from '../services/resolution/types';
+import { GraphNode, GraphEdge, PatientContext } from '../services/confidence/types';
+import { makeGraphContext } from './fixtures/reference-patient-context';
+
+const node = (id: string, nodeType: string, properties = {}): GraphNode => ({ id, nodeIdentifier: id, nodeType, properties: { title: id, ...properties } });
+const edge = (sourceId: string, targetId: string, edgeType = 'HAS_CHILD', properties = {}): GraphEdge => ({ id: `${sourceId}-${targetId}`, sourceId, targetId, edgeType, properties });
+const pc = { patientId: 'p', conditionCodes: [], medications: [], allergies: [], labResults: [] } as PatientContext;
+const engine = (weak = '') => new TraversalEngine({ computeNodeConfidence: async (n: GraphNode) => ({ confidence: n.nodeIdentifier === weak ? 0.1 : 0.9, breakdown: [], contextInputs: ['labs'] }) } as never,
+  { autoResolveThreshold: 0.85, suggestThreshold: 0.6 }, makeEvaluationTemporalContext({ evaluationAsOf: '2026-09-03T12:00:00Z', temporalPolicyVersion: 'legacy-v0' }), {}, [], new Map());
+
+test('context rescoring cannot reopen a medication behind an answered-closed gate', async () => {
+  const g = makeGraphContext([node('root', 'Pathway'), node('q', 'Gate', { gate_type: GateType.QUESTION, answer_type: AnswerType.BOOLEAN, default_behavior: DefaultBehavior.SKIP }), node('med', 'Medication')], [edge('root', 'q'), edge('q', 'med')]);
+  const answers = new Map([['q', { booleanValue: true }]]);
+  const e = engine();
+  const r = await e.traverse(g, pc, answers);
+  answers.set('q', { booleanValue: false });
+  await e.resolveIncrementally(new Set(['q']), r.resolutionState, r.dependencyMap, g, pc, answers);
+  expect(r.resolutionState.get('med')!.status).toBe(NodeStatus.GATED_OUT);
+  expect(r.dependencyMap.scorerInputs.get('med')).toContain('labs');
+  // addPatientContext seeds med because its recorded scorer reads labs;
+  // the question gate itself does not depend on patient labs.
+  await e.resolveIncrementally(new Set(['med']), r.resolutionState, r.dependencyMap, g, pc, answers);
+  expect(r.resolutionState.get('q')!.status).toBe(NodeStatus.GATED_OUT);
+  expect(r.resolutionState.get('med')!.status).toBe(NodeStatus.GATED_OUT);
+});
+
+test('an included override below a closing gate must not pre-enqueue its medication', async () => {
+  const g = makeGraphContext([node('root', 'Pathway'), node('q', 'Gate', { gate_type: GateType.QUESTION, answer_type: AnswerType.BOOLEAN, default_behavior: DefaultBehavior.SKIP }), node('step', 'Step'), node('med', 'Medication')], [edge('root', 'q'), edge('q', 'step'), edge('step', 'med')]);
+  const answers = new Map([['q', { booleanValue: true }]]);
+  const e = engine();
+  const r = await e.traverse(g, pc, answers);
+  r.resolutionState.get('step')!.providerOverride = { action: OverrideAction.INCLUDE, originalStatus: NodeStatus.INCLUDED, originalConfidence: 0.9 };
+  answers.set('q', { booleanValue: false });
+  await e.resolveIncrementally(new Set(['q']), r.resolutionState, r.dependencyMap, g, pc, answers);
+  expect(r.resolutionState.get('q')!.status).toBe(NodeStatus.GATED_OUT);
+  expect(r.resolutionState.get('med')!.status).not.toBe(NodeStatus.INCLUDED);
+});
+
+test('all_of retains a weak action branch and reports it unsupported', async () => {
